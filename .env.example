# ════════════════════════════════════════════════════════════════════
# Розумний Дачник — .env.example
# СКОПІЮЙТЕ як .env і заповніть РЕАЛЬНИМИ значеннями
# НІКОЛИ не комітьте .env у git!
#
# FIX S-08: реальні ключі замінено на PLACEHOLDER
# ════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
APP_NAME=Розумний Дачник
# === Environment ===
# development | staging | production
ENVIRONMENT=development
DEBUG=true

# ── Security ─────────────────────────────────────────────────────
# === Security ===
# Generate: openssl rand -hex 64
SECRET_KEY=replace_me_with_64_char_hex_string_for_production_use

ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# === CORS ===
# Comma-separated list, no spaces. У production — лише реальні домени.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Database ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://smartdacha:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/smartdacha
DATABASE_SYNC_URL=postgresql+psycopg2://smartdacha:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/smartdacha

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD  # Увімкніть в production

# ── Storage S3 ────────────────────────────────────────────────────
S3_BUCKET=smartdacha-media
S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_AWS_SECRET_KEY
# S3_ENDPOINT_URL=https://...  # Для MinIO/Cloudflare R2 (залиште порожнім для AWS)
# CDN_BASE_URL=https://cdn.yourdomain.com  # Якщо є CloudFront/CDN

# ── External APIs ─────────────────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GOOGLE_VISION_API_KEY=REPLACE_WITH_YOUR_GOOGLE_VISION_KEY

# ── Firebase ─────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET
STRIPE_PREMIUM_PRICE_ID=price_REPLACE_WITH_PREMIUM_PRICE_ID
STRIPE_PREMIUM_PLUS_PRICE_ID=price_REPLACE_WITH_PREMIUM_PLUS_PRICE_ID

# ── Flower ───────────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=REPLACE_WITH_FLOWER_PASSWORD

# ── Frontend URL (для CORS) ───────────────────────────────────────
FRONTEND_URL=https://app.smartdacha.ua
ADMIN_EMAILS=admin@example.com

# === Email / SMTP ===
# Needed for "Forgot password" emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Smart Gardener
SMTP_USE_TLS=true

# === Observability ===
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05
RELEASE_VERSION=dev
PROMETHEUS_METRICS_ENABLED=true
LOG_FORMAT=text

# === Backups (PRODUCTION ONLY) ===
# These are required ONLY when starting backup service via:
# docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#   --profile production up -d backup
# In dev (docker compose up -d), backup service is not loaded - these can be empty.
BACKUP_BUCKET=
BACKUP_RCLONE_REMOTE=b2
BACKUP_HEALTHCHECK_URL=
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_REMOTE_RETENTION_DAYS=90
